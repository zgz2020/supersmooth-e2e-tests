{
  "name": "sov-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API, mock and UI testing suite for Supersmooth",
  "main": "index.js",
  "scripts": {
    "synpress-build-cache:base": "pnpm synpress ./utils/synpress/wallet-setup",
    "ci:synpress-build-cache:base": "xvfb-run pnpm synpress-build-cache:base",
    "test:no-wallet": "REPORT_FOLDER=no-wallet playwright test --project=no-wallet",
    "ci:no-wallet": "WORKERS='2' FULLY_PARALLEL='true' xvfb-run pnpm test:no-wallet",
    "test:no-wallet-regression": "REPORT_FOLDER=no-wallet playwright test --grep @regression --project=no-wallet",
    "ci:no-wallet-regression": "WORKERS='2' FULLY_PARALLEL='true' xvfb-run pnpm test:no-wallet-regression",
    "test:with-wallet": "REPORT_FOLDER=with-wallet playwright test --project=with-wallet",
    "ci:with-wallet": "WORKERS='1' FULLY_PARALLEL='true' xvfb-run pnpm test:with-wallet",
    "test:with-wallet-regression": "REPORT_FOLDER=with-wallet playwright test --grep @regression --project=with-wallet",
    "ci:with-wallet-regression": "WORKERS='1' FULLY_PARALLEL='true' xvfb-run pnpm test:with-wallet-regression",
    "test:api": "REPORT_FOLDER=api-tests playwright test --project=api",
    "test:api:regression": "REPORT_FOLDER=api-tests playwright test --project=api-regression",
    "test:api:fake-geo": "REPORT_FOLDER=api-tests-fake-geo playwright test --project=api-fake-geo",
    "test:repeat": "node scripts/repeat-tests.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "typescript"
  ],
  "author": "zgz2020",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@synthetixio/synpress": "^4.0.3",
    "@types/node": "^26.4.1",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "playwright-core": "^1.49.1"
    }
  }
}
