{
  "name": "sov-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "description": "API, mock and UI testing suite for Supersmooth",
  "main": "index.js",
  "scripts": {
    "// --- CODE QUALITY & BUILD ---": "",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "// --- SYNPRESS WALLET SETUP ---": "",
    "synpress-build-cache:base": "pnpm synpress ./utils/synpress/wallet-setup",
    "ci:synpress-build-cache:base": "xvfb-run pnpm synpress-build-cache:base",
    "// --- E2E PLAYWRIGHT (NO-WALLET) ---": "",
    "test:no-wallet": "REPORT_FOLDER=no-wallet playwright test --project=no-wallet",
    "ci:no-wallet": "WORKERS='2' FULLY_PARALLEL='true' xvfb-run pnpm test:no-wallet",
    "test:no-wallet-regression": "REPORT_FOLDER=no-wallet playwright test --grep @regression --project=no-wallet",
    "ci:no-wallet-regression": "WORKERS='2' FULLY_PARALLEL='true' xvfb-run pnpm test:no-wallet-regression",
    "// --- E2E PLAYWRIGHT (WITH-WALLET) ---": "",
    "test:with-wallet": "REPORT_FOLDER=with-wallet playwright test --project=with-wallet",
    "ci:with-wallet": "WORKERS='1' FULLY_PARALLEL='true' xvfb-run pnpm test:with-wallet",
    "test:with-wallet-regression": "REPORT_FOLDER=with-wallet playwright test --grep @regression --project=with-wallet",
    "ci:with-wallet-regression": "WORKERS='1' FULLY_PARALLEL='true' xvfb-run pnpm test:with-wallet-regression",
    "// --- E2E PLAYWRIGHT (ANVIL FORK) ---": "",
    "test:anvil": "REPORT_FOLDER=anvil playwright test --project=anvil",
    "test:anvil:headed": "REPORT_FOLDER=anvil playwright test --project=anvil --headed",
    "test:anvil:regression": "REPORT_FOLDER=anvil playwright test --grep @regression --project=anvil",
    "ci:anvil": "WORKERS='2' FULLY_PARALLEL='true' pnpm test:anvil",
    "ci:anvil:regression": "WORKERS='2' FULLY_PARALLEL='true' pnpm test:anvil:regression",
    "// --- E2E CROSS-BROWSER SUITES ---": "",
    "test:cross-browser": "REPORT_FOLDER=cross-browser playwright test --project=firefox --project=webkit --project=mobile-safari --project=mobile-android --project=tablet-ipad --project=desktop-large",
    "test:cross-browser:firefox": "REPORT_FOLDER=cross-browser-firefox playwright test --project=firefox",
    "test:cross-browser:webkit": "REPORT_FOLDER=cross-browser-webkit playwright test --project=webkit",
    "test:cross-browser:mobile-safari": "REPORT_FOLDER=cross-browser-mobile-safari playwright test --project=mobile-safari",
    "test:cross-browser:mobile-android": "REPORT_FOLDER=cross-browser-mobile-android playwright test --project=mobile-android",
    "test:cross-browser:tablet-ipad": "REPORT_FOLDER=cross-browser-tablet-ipad playwright test --project=tablet-ipad",
    "test:cross-browser:desktop-large": "REPORT_FOLDER=cross-browser-desktop-large playwright test --project=desktop-large",
    "ci:cross-browser": "xvfb-run pnpm test:cross-browser",
    "// --- API TESTING ---": "",
    "test:api": "REPORT_FOLDER=api-tests playwright test --project=api",
    "test:api:regression": "REPORT_FOLDER=api-tests playwright test --project=api-regression",
    "test:api:fake-geo": "REPORT_FOLDER=api-tests-fake-geo playwright test --project=api-fake-geo",
    "// --- GRAFANA K6 PERFORMANCE TESTING ---": "",
    "test:performance": "mkdir -p performance-reports/history && k6 run -c k6.config.json -o web-dashboard=export=performance-reports/dashboard.html tests/performance/main.perf.ts",
    "test:performance:menu": "node scripts/run-performance.js",
    "test:performance:smoke": "K6_PROFILE=smoke pnpm test:performance",
    "test:performance:load": "K6_PROFILE=load pnpm test:performance",
    "test:performance:stress": "K6_PROFILE=stress pnpm test:performance",
    "test:performance:spike": "K6_PROFILE=spike pnpm test:performance",
    "test:performance:soak": "K6_PROFILE=soak pnpm test:performance",
    "test:performance:api": "K6_SCENARIO=api pnpm test:performance",
    "test:performance:web": "K6_SCENARIO=web pnpm test:performance",
    "// --- TEST UTILITIES ---": "",
    "rpc:gateway": "node scripts/local-rpc-gateway.js",
    "test:local-node": "docker compose -f docker-compose.test.yml up --abort-on-container-exit --exit-code-from e2e-runner",
    "test:repeat": "node scripts/repeat-tests.js",
    "app:fork": "node scripts/run-app-fork.js",
    "// --- APPLIED AI & AGENT QA ---": "",
    "agent:triage": "node scripts/qa-agent/triage-agent.js",
    "agent:heal": "node scripts/qa-agent/heal-agent.js",
    "agent:heal:pr": "node scripts/qa-agent/heal-agent.js --create-pr",
    "agent:impact": "node scripts/qa-agent/pr-impact-analyzer.js",
    "agent:cleanup-branches": "node scripts/qa-agent/cleanup-branches.js",
    "agent:crawl": "node scripts/qa-agent/crawl-vaults.js",
    "agent:crawl:all": "node scripts/qa-agent/crawl-vaults.js --all-pages",
    "test:unit": "REPORT_FOLDER=unit playwright test --project=unit && node tests/unit/pr-impact-analyzer.test.js && node tests/unit/batch-safety-and-retention.test.js && node tests/unit/crawl-vaults.test.js"
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "typescript"
  ],
  "author": "zgz2020",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@synthetixio/synpress": "^4.0.3",
    "@types/k6": "^2.3.1",
    "@types/node": "^26.4.1",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "viem": "^2.57.18"
  },
  "pnpm": {
    "overrides": {
      "playwright-core": "^1.49.1"
    }
  }
}
