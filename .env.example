# ==============================================================================
# Environment Configuration Template
# Copy this file to `.env` and fill in the values.
# NEVER commit real private keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Target Application & General Playwright Config
# ------------------------------------------------------------------------------
# Primary application URL for live tests (e.g. https://staging.supersmooth.fi)
BASE_URL='https://staging.supersmooth.fi'

# Base URL for Anvil fork tests (defaults to http://localhost:3000 where aphelion-app runs)
FORK_BASE_URL='http://localhost:3000'

# Execution mode: true for headless browser, empty for headed (visible browser)
HEADLESS=

# Output subfolder under `playwright-reports/`
REPORT_FOLDER='local'

# Number of parallel Playwright test workers (default: auto based on CPU count)
WORKERS=

# Additional test run tuning
FULLY_PARALLEL=
RETRIES=

# ------------------------------------------------------------------------------
# 2. Synpress / MetaMask Test Wallet
# ------------------------------------------------------------------------------
# 64-character private key (with or without 0x prefix) used to import the test wallet
TEST_WALLET_PK=

# Public checksummed address of the funded test wallet (used for API and status verifications)
TEST_WALLET_ADDRESS='0x44E361c3D9dcd703D535f9c2883a4E104AD2F4d5'

# ------------------------------------------------------------------------------
# 3. Local Anvil Fork & aphelion-app Orchestration (`pnpm app:fork` & `pnpm test:anvil`)
# ------------------------------------------------------------------------------
# Path to your local aphelion-app checkout (default: ../aphelion-app; prompted if unset)
APHELION_APP_DIR=

# Base port for test-worker Anvil nodes (port = ANVIL_BASE_PORT + parallelIndex). Keep clear of 8545, used by `pnpm app:fork`
ANVIL_BASE_PORT=8600

# Default chain to fork: 1 (Ethereum Mainnet), 8453 (Base), 42161 (Arbitrum One)
ANVIL_FORK_CHAIN=1

# Optional custom archive RPC URL for forking (defaults to verified public archive RPCs)
ANVIL_FORK_URL=

# Optional block height pinning for 100% deterministic state reproduction
ANVIL_FORK_BLOCK=

# Optional path to custom anvil binary (auto-detected via PATH and ~/.foundry/bin/anvil if unset)
ANVIL_PATH=

# Extra custom tokens to pre-fund on fork startup (format: "0xAddress:Amount" or "0xAddress:Amount:Whale")
EXTRA_FUNDING_TOKENS=

# ------------------------------------------------------------------------------
# 4. Mock Compliance Server & Local Geo-Fencing
# ------------------------------------------------------------------------------
# Mock server command for geo-location compliance testing
WEB_SERVER_COMMAND='node scripts/mock-compliance-server.js'
PORT=3000
LOCAL_BASE_URL='http://localhost:3000'
LOCAL_GEO=

# ------------------------------------------------------------------------------
# 5. Grafana k6 Performance Tests
# ------------------------------------------------------------------------------
# Target host for k6 performance tests (falls back to BASE_URL if unset)
K6_BASE_URL=

# Execution profile: smoke | load | stress | spike | soak (default: smoke)
K6_PROFILE=smoke

# Optional overrides for quick iterations
K6_VUS=
K6_DURATION=

# Target scenario when running main.perf.ts: all | api | web (default: all)
K6_SCENARIO=all

# Target specific endpoints/pages (e.g. "earn,borrow" or "tokens,rpc")
K6_TARGET=

# ------------------------------------------------------------------------------
# 6. Applied AI & Agent QA Triage (`pnpm agent:triage`)
# ------------------------------------------------------------------------------
# Optional Google Gemini API Key for deep LLM failure diagnostics (heuristic fallback if unset)
GEMINI_API_KEY=

# Optional Discord Incoming Webhook URL to receive instant failure diagnostic cards
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 7. Environment Timeouts & CI Scaling
# ------------------------------------------------------------------------------
# Optional multiplier to scale all test and assertion timeouts (defaults to 1.5 in CI, 1.0 locally)
TIMEOUT_MULTIPLIER=1.0

# Optional explicit overrides in milliseconds
EXPECT_TIMEOUT_ANVIL=30000
TEST_TIMEOUT_ANVIL=120000
EXPECT_TIMEOUT_STAGING=10000
TEST_TIMEOUT_STAGING=60000
EXPECT_TIMEOUT_WITH_WALLET=15000
TEST_TIMEOUT_WITH_WALLET=90000
EXPECT_TIMEOUT_API=5000
TEST_TIMEOUT_API=30000

