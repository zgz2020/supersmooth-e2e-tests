# Copy this file to `.env` and fill in the values.
# Never commit real private keys.

# Target app URL (e.g. https://staging.supersmooth.fi)
BASE_URL=

# Leave HEADLESS empty for headed tests
HEADLESS=

# Output folder for Playwright reports
REPORT_FOLDER=

# Number of parallel workers
WORKERS=

# Optional run tuning
FULLY_PARALLEL=
RETRIES=

# Optional local web server
WEB_SERVER_COMMAND=
PORT=
LOCAL_BASE_URL=
LOCAL_GEO=

# Synpress / MetaMask test wallet
# Private key used to import the test wallet into MetaMask
TEST_WALLET_PK=
# Public address of the wallet above (used for Terms of Service status checks)
TEST_WALLET_ADDRESS=

# Grafana k6 Performance Tests
# Target host (falls back to BASE_URL if unset, or https://staging.supersmooth.fi)
K6_BASE_URL=
# Execution profile: smoke | load | stress | spike | soak (default: smoke)
K6_PROFILE=
# Optional overrides for quick iterations
K6_VUS=
K6_DURATION=
# Target scenario when running main.perf.ts: all | api | web (default: all)
K6_SCENARIO=
# Target specific endpoints/pages (optional comma-separated e.g. "earn,borrow" or "tokens,rpc")
K6_TARGET=

# Local dApp & Anvil Fork Testing (`pnpm app:fork`)
# Optional path to local aphelion-app repository (prompted interactively if unset)
APHELION_APP_DIR=
# Default chain to fork: 1 (Ethereum Mainnet), 8453 (Base), 42161 (Arbitrum)
ANVIL_FORK_CHAIN=1
# Optional custom archive RPC URL for forking (defaults to curated public archive RPCs)
ANVIL_FORK_URL=
# Optional additional tokens to fund on fork (e.g. "0xAddress:10000,0xAddress2:5000")
EXTRA_FUNDING_TOKENS=
